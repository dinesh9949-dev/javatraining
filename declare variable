import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        int a;
        float b;
        String c;

        Scanner sc = new Scanner(System.in);

        a = sc.nextInt();
        b = sc.nextFloat();
        sc.nextLine();   // clears the newline left by nextFloat()
        c = sc.nextLine();

        System.out.println(a);
        System.out.println(b);
        System.out.println(c);
    }
}
