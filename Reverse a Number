import java.util.Scanner;

public class ReverseNumber {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int N = sc.nextInt();
        sc.close();
        int rev = 0;
        while (N > 0) {
            int digit = N % 10;
            rev = rev * 10 + digit;
            N /= 10;
        }

        System.out.println(rev);
    }
}
